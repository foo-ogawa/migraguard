ARG NODE_VERSION=22
ARG GITHUB_TOKEN
FROM node:${NODE_VERSION}-alpine
RUN apk add --no-cache sqlite git
WORKDIR /app/migraguard
COPY migraguard/package.json migraguard/package-lock.json migraguard/.npmrc ./
COPY agent-contracts-analyzer /app/agent-contracts-analyzer
RUN if [ -n "$GITHUB_TOKEN" ]; then \
      git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/" && \
      git config --global url."https://x-access-token:${GITHUB_TOKEN}@github.com/".insteadOf "git@github.com:"; \
    fi && \
    echo "allow-git=all" >> .npmrc && \
    npm ci --legacy-peer-deps
RUN cd /app/agent-contracts-analyzer && npm run build
RUN apk add --no-cache python3 make gcc g++ musl-dev && \
    npm_config_ignore_scripts=false npm rebuild better-sqlite3
COPY migraguard/ .
RUN npm run build
CMD ["npm", "run", "test:unit"]
